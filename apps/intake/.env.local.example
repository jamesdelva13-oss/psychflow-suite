# Copy to .env.local and fill with values from your Supabase project.
# .env.local is gitignored — the service_role key must never be committed
# and must never be exposed to the browser (no NEXT_PUBLIC_ prefix).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Full DB access, bypasses RLS. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Base URL used to build invitation links (dev default below).
APP_BASE_URL=http://localhost:3000

# Capture summarization (D-125). Server-only — the Anthropic API key must
# never be exposed to the browser (no NEXT_PUBLIC_ prefix). Without a key,
# "Draft summary" fails gracefully; notes-only capture still works.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Pinned model for capture summaries; a change here is a deliberate,
# provenance-visible act (logged per proposal in summary_proposal.generation).
RIE_CAPTURE_MODEL=claude-opus-5
