# apps/intake environment — copy to .env.local and fill in. Never commit values.

# Supabase project (dev instance; synthetic data only per data-posture §10)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the respondent session cookie (D-024)
RESPONDENT_COOKIE_SECRET=

# Base URL used to build invitation links
APP_BASE_URL=http://localhost:3000

# Capture summarization (D-125) — server-side only
ANTHROPIC_API_KEY=

# Invitation email delivery (directive §3.2 deployable-RIE gate).
# Absent ⇒ the app still works: delivery reports "email_not_configured"
# and the copy-link/QR flow is unaffected. Provider is deployment config
# (Resend-compatible HTTP shape); vendor/DPA choice is a JD deployment
# decision. EMAIL_FROM must be a verified sender on the provider.
EMAIL_API_KEY=
EMAIL_FROM=
# EMAIL_API_URL=https://api.resend.com/emails

# Serve the UNRATIFIED teacher bank draft for development only
# INTAKE_BANK_PREVIEW=1.5.0
